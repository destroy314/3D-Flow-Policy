{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Train Policy Script",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/3D-Diffusion-Policy",
            "program": "train.py",
            "args": [
                "--config-name=simple_dp3_dit.yaml",
                "task=metaworld_assembly",
                "hydra.run.dir=data/outputs/debug",
                "training.debug=True",
                "training.seed=0",
                "training.device=cuda:0",
                "exp_name=debug",
                "logging.mode=offline",
                "checkpoint.save_ckpt=False"
            ],
            "env": {
                "HYDRA_FULL_ERROR": "1",
                "CUDA_VISIBLE_DEVICES": "0"
            },
            "console": "integratedTerminal"
        }
    ]
}